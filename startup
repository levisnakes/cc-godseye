local RGB = {
  bg     = { 6, 0, 1 },
  scope  = { 20, 2, 4 },
  grid   = { 64, 7, 11 },
  bar    = { 40, 4, 6 },
  dim    = { 140, 42, 46 },
  red    = { 227, 19, 27 },
  bright = { 255, 214, 214 },
  black  = { 0, 0, 0 },
  ship   = { 125, 125, 135 },
}
local FS = 12
local gpuButtons, lastClick = {}, 0
local radarFrameMs = 0

local function openDisplay()
  if not gpu then return false end
  if disp then return true end
  local ok, id
  if CFG.gpuRes then ok, id = pcall(gpu.autoDetectAndCreateDisplayWithResolution, CFG.gpuRes)
  else ok, id = pcall(gpu.autoDetectAndCreateDisplay) end
  if not ok or type(id) ~= "number" then
    lastErr, page = "gpu: " .. tostring(id), "log"
    return false
  end
  local ok2, info = pcall(gpu.getDisplayInfo, id)
  if not ok2 or type(info) ~= "table" or not info.pixelWidth then
    pcall(gpu.removeDisplay, id)
    lastErr, page = "gpu: no display info", "log"
    return false
  end
  disp, dpw, dph = id, info.pixelWidth, info.pixelHeight
  pcall(gpu.clearEvents, disp)
  return true
end

local function closeDisplay()
  if gpu and disp then pcall(gpu.removeDisplay, disp) end
  disp = nil
end

local function fl(v) return math.floor(v + 0.5) end
local function cw(n, size) return n * (size or FS) * 0.6 end   -- approx monospace width
local function gtext(s, x, y, c, size, style)
  pcall(gpu.drawText, disp, s, fl(x), fl(y), c[1], c[2], c[3], CFG.radarFont, fl(size or FS), style or "plain")
end
local function gbox(x, y, w, h, c)
  pcall(gpu.fillRect, disp, fl(x), fl(y), fl(w), fl(h), c[1], c[2], c[3])
end
local function gline(x1, y1, x2, y2, c)
  pcall(gpu.drawLine, disp, fl(x1), fl(y1), fl(x2), fl(y2), c[1], c[2], c[3])
end
local function gcircle(x, y, r, c, filled)
  pcall(gpu.drawCircle, disp, fl(x), fl(y), math.max(1, fl(r)), c[1], c[2], c[3], filled and true or false)
end
local function gbutton(id, label, x, y, h, fg, bg)
  local w = cw(#label) + FS
  gbox(x, y, w, h, bg)
  gtext(label, x + FS / 2, y + (h - FS) / 2, fg, FS, "bold")
  gpuButtons[#gpuButtons + 1] = { id = id, x1 = x, y1 = y, x2 = x + w, y2 = y + h }
  return x + w + FS * 0.5
end

local function blipColor(a)
  if a.black then return RGB.red end
  if a.friend then return RGB.dim end
  return lvl().hostileUnknown and RGB.red or RGB.bright
end

local function drawRadarPage()
  FS = math.max(10, math.floor(math.min(dpw / 60, dph / 28)))
  local small = math.max(8, fl(FS * 0.8))
  local hh, fh = fl(FS * 2.2), fl(FS * 2.4)
  local now = nowMs()
  gpuButtons = {}
  pcall(gpu.clear, disp, RGB.bg[1], RGB.bg[2], RGB.bg[3])

  -- header bar (flashes on alerts, like the text page)
  local flashing = now < alertUntil and (math.floor(now / 400) % 2 == 0)
  local hb = flashing and RGB.bright or RGB.red
  gbox(0, 0, dpw, hh, hb)
  gtext("<(o)>  GOD'S EYE  //  RADAR", FS * 0.6, (hh - FS) / 2, RGB.black, FS, "bold")
  local clock = fmtT(nowSec(), { secs = true }) .. " " .. CFG.tzLabel
  gtext(clock, dpw - cw(#clock) - FS * 0.6, (hh - FS) / 2, RGB.black, FS, "bold")

  -- scope geometry: square on the left, info panel on the right
  local top, bottom = hh + FS * 0.6, dph - fh - FS * 0.6
  local panelW = math.max(cw(28), dpw * 0.3)
  local size = math.max(40, math.min(bottom - top, dpw - panelW - FS * 2))
  local R = size / 2
  local cx, cy = FS * 0.8 + R, top + R
  local range = CFG.radarRange or CFG.radius * 1.5
  local s = R / range

  gcircle(cx, cy, R, RGB.scope, true)
  for i = 1, 3 do gcircle(cx, cy, R * i / 4, RGB.grid, false) end
  gline(cx - R, cy, cx + R, cy, RGB.grid)
  gline(cx, cy - R, cx, cy + R, RGB.grid)

  -- sweep with a fading trail (time-based so it's smooth at any frame rate)
  local sweep = (now / 1000 * CFG.sweepSpeed) % (2 * math.pi)
  for i = 5, 0, -1 do
    local a = sweep - i * 0.09
    local t = 1 - i / 6
    local c = { fl(RGB.grid[1] + (RGB.red[1] - RGB.grid[1]) * t),
                fl(RGB.grid[2] + (RGB.red[2] - RGB.grid[2]) * t),
                fl(RGB.grid[3] + (RGB.red[3] - RGB.grid[3]) * t) }
    gline(cx, cy, cx + math.cos(a) * R, cy + math.sin(a) * R, c)
  end

  -- zone rings
  local zr, br = math.min(R, CFG.radius * s), math.min(R, CFG.breachRadius * s)
  gcircle(cx, cy, zr, RGB.dim, false)
  gcircle(cx, cy, br, RGB.red, false)
  gcircle(cx, cy, R, RGB.red, false)
  gtext("ZONE " .. CFG.radius, cx + 3, cy - zr + 2, RGB.dim, small)
  gtext("BREACH " .. CFG.breachRadius, cx + 3, cy - br + 2, RGB.red, small)
  gtext(fl(range) .. "m", cx + R * 0.72, cy + R * 0.72, RGB.dim, small)

  -- compass letters + base marker
  gtext("N", cx - cw(1, small) / 2, cy - R + 3, RGB.red, small, "bold")
  gtext("S", cx - cw(1, small) / 2, cy + R - small - 3, RGB.dim, small, "bold")
  gtext("E", cx + R - cw(1, small) - 4, cy - small / 2, RGB.dim, small, "bold")
  gtext("W", cx - R + 4, cy - small / 2, RGB.dim, small, "bold")
  gline(cx - 5, cy, cx + 5, cy, RGB.bright)
  gline(cx, cy - 5, cx, cy + 5, RGB.bright)

  -- ships / contraptions
  local shipsIn = 0
  if CFG.radarShowShips then
    for _, sh in ipairs(shipTracks) do
      local dx, dz = (sh.x - CFG.baseX) * s, (sh.z - CFG.baseZ) * s
      if dx * dx + dz * dz <= R * R then
        shipsIn = shipsIn + 1
        local q = math.max(2, FS * 0.25)
        gbox(cx + dx - q, cy + dz - q, q * 2, q * 2, RGB.ship)
      end
    end
  end

  -- players
  local list = {}
  for _, a in pairs(active) do list[#list + 1] = a end
  table.sort(list, function(p, q) return (p.dist or 1e9) < (q.dist or 1e9) end)
  local bR = math.max(3, FS * 0.35)
  for _, a in ipairs(list) do
    if a.x then
      local dx, dz = (a.x - CFG.baseX) * s, (a.z - CFG.baseZ) * s
      local d = math.sqrt(dx * dx + dz * dz)
      if d > R - bR then dx, dz = dx / d * (R - bR), dz / d * (R - bR) end   -- pin to edge
      local px, py = cx + dx, cy + dz
      local c = blipColor(a)
      if a.black then
        gcircle(px, py, bR * 2 + (math.floor(now / 250) % 3), RGB.red, false)
      end
      if a.trend and a.trend < -0.3 and d > 1 then       -- closing: tail pointing at base
        gline(px, py, px - dx / d * bR * 3, py - dz / d * bR * 3, RGB.red)
      end
      gcircle(px, py, bR, c, not a.friend)
      gtext(a.name, px + bR + 3, py - small, c, small, "bold")
      gtext((a.dist and fl(a.dist) .. "m" or "?") .. " " .. compass(a.x, a.z), px + bR + 3, py, RGB.dim, small)
    end
  end

  -- right panel
  local x0 = cx + R + FS * 1.2
  local pw = dpw - x0 - FS * 0.6
  local y = top
  local L = curLevel()
  gbox(x0, y, pw, FS * 1.8, L <= 2 and RGB.red or RGB.bar)
  gtext(("LEVEL %d  %s"):format(L, LEVELS[L].name), x0 + FS * 0.5, y + FS * 0.4,
        L <= 2 and RGB.black or RGB.bright, FS, "bold")
  y = y + FS * 2.4

  local st, who = threatLevel()
  local stText = ({ SECURE = "AREA SECURE", CONTACT = "CONTACT", BREACH = "BREACH",
                    BLACKLIST = "BLACKLISTED", LINK_LOST = "SENSORS OFFLINE" })[st] or st
  local stCol = st == "SECURE" and RGB.dim or ((st == "CONTACT") and RGB.bright or RGB.red)
  local blink = (st == "BREACH" or st == "BLACKLIST" or st == "LINK_LOST") and (math.floor(now / 400) % 2 == 1)
  if not blink then gtext(stText, x0, y, stCol, fl(FS * 1.4), "bold") end
  y = y + FS * 1.7
  if who then gtext(who, x0, y, stCol, small) end
  y = y + FS * 1.4

  gbox(x0, y, pw, FS * 1.4, RGB.bar)
  gtext(("CONTACTS  %d"):format(#list), x0 + FS * 0.4, y + FS * 0.2, RGB.red, FS, "bold")
  y = y + FS * 1.8
  local rows = math.max(1, math.floor((bottom - y - FS * 3) / (FS * 1.3)))
  if #list == 0 then gtext("no contacts", x0 + FS * 0.4, y, RGB.dim, small) y = y + FS * 1.3 end
  for i = 1, math.min(#list, rows) do
    local a = list[i]
    local c = blipColor(a)
    gcircle(x0 + FS * 0.5, y + FS * 0.45, math.max(2, FS * 0.25), c, not a.friend)
    gtext(a.name, x0 + FS * 1.2, y, c, small, "bold")
    local info = (a.dist and fl(a.dist) .. "m " or "") .. compass(a.x, a.z)
              .. ((a.trend and a.trend < -0.3) and "  >>" or "")
    gtext(info, x0 + pw - cw(#info, small), y, RGB.dim, small)
    y = y + FS * 1.3
  end

  local foot = ("SHIPS %d   RANGE %dm   FRAME %dms"):format(shipsIn, fl(range), radarFrameMs)
  gtext(foot, x0, bottom - small, RGB.dim, small)

  -- footer: back button + level buttons
  local fy = dph - fh
  gbox(0, fy, dpw, fh, RGB.bar)
  local bh, by = fh - FS * 0.6, fy + FS * 0.3
  local bx = gbutton("log", "< LOG", FS * 0.5, by, bh, RGB.black, RGB.bright)
  bx = bx + FS * 0.5
  for n = 1, 5 do
    local on = n == L
    bx = gbutton("lvl" .. n, n .. " " .. LEVELS[n].name, bx, by, bh,
                 on and RGB.black or (n <= 2 and RGB.red or RGB.dim),
                 on and (n <= 2 and RGB.red or RGB.bright) or RGB.bg)
  end
  if toast and now < toastUntil and bx + cw(#toast, small) < dpw then
    gtext(toast, dpw - cw(#toast, small) - FS * 0.5, fy + (fh - small) / 2, RGB.bright, small)
  end
end

local function handleGpuClick(x, y)
  if nowMs() - lastClick < 400 then return end      -- GPU + monitor_touch can both fire
  for _, b in ipairs(gpuButtons) do
    if x >= b.x1 and x <= b.x2 and y >= b.y1 and y <= b.y2 then
      lastClick = nowMs()
      if b.id == "log" then page = "log"
      elseif b.id:match("^lvl%d$") then setLevel(tonumber(b.id:sub(4))) end
      return
    end
  end
end

local function radarLoop()
  while true do
    if page == "radar" and gpu then
      if openDisplay() then
        local t0 = nowMs()
        local ok, err = pcall(drawRadarPage)
        if not ok then lastErr = "radar: " .. tostring(err) end
        pcall(gpu.updateDisplay, disp)
        radarFrameMs = nowMs() - t0               -- shown on the radar page
        for _ = 1, 8 do
          local okE, e = pcall(gpu.pollEvent, disp)
          if not okE or type(e) ~= "table" then break end
          local t = tostring(e.type)
          if (t == "mouse_click" or t == "click" or t == "mouse_down") and e.x then
            handleGpuClick(e.x, e.y)
          end
        end
      end
      sleep(math.max(0.05, 1 / CFG.radarFps - radarFrameMs / 1000))
    else
      if disp then closeDisplay() end
      sleep(0.2)
    end
  end
end

local function eventLoop()
  while true do
    local ev, a1, a2, a3, a4 = os.pullEvent()
    if bot then bot:handleEvent(ev, a1, a2, a3) end
    if (ev == "monitor_touch" or ev == "mouse_click") and page == "radar" and disp then
      local mw, mh = mon.getSize()               -- text cell -> GPU pixel
      if mw then handleGpuClick((a2 - 0.5) / mw * dpw, (a3 - 0.5) / mh * dph) end
    elseif ev == "monitor_touch" or ev == "mouse_click" then
      local hit = false
      for _, b in ipairs(buttons) do
        if a3 == b.y and a2 >= b.x1 and a2 <= b.x2 then onButton(b.id) hit = true break end
      end
      if not hit and rowTargets[a3] and a2 <= listRight then   -- tapped a player row
        local name = rowTargets[a3]
        if selected == name then selected = nil
        else selected, selectedUntil = name, nowMs() + 20000 end
      end
    elseif ev == "peripheral" or ev == "peripheral_detach" then
      radar, radarName = findRadar()
      detector, detectorName = findDetector()
      hudModem = findHudModem()
      openRemote()
      gpu, gpuName = findGpu()
      if not gpu then disp, page = nil, "log" end
    elseif ev == "modem_message" and CFG.remoteChannel and a2 == CFG.remoteChannel then
      -- a1 = modem side, a3 = reply channel, a4 = packet
      if type(a4) == "table" and (a4.action == "INJECT_PLAYER" or a4.action == "REMOVE_PLAYER") then
        local ok, text = handleRemote(a4)
        if ok then
          toast, toastUntil = "REMOTE: " .. text, nowMs() + 5000
          pollNow = true                   -- mainLoop logs + alerts on its next tick
        end
        local m = peripheral.wrap(a1)
        if m and m.transmit and type(a3) == "number" then
          pcall(m.transmit, a3, CFG.remoteChannel,
            { action = "INJECT_ACK", ok = ok, name = a4.name, msg = text, base = CFG.baseName })
        end
      end
    elseif ev == "http_success" and a1 == CFG.webhookUrl then
      a2.close()
      if lastErr and lastErr:find("^webhook") then lastErr = nil end
    elseif ev == "http_failure" and a1 == CFG.webhookUrl then
      lastErr = "webhook: " .. tostring(a2)
      if a3 then a3.close() end
    end
  end
end

-- auto-restart on crashes (Ctrl+T still stops it)
while true do
  local tasks = { mainLoop, eventLoop, radarLoop, webLoop }
  if bot then tasks[#tasks + 1] = function() bot:run() end end
  local ok, err = pcall(parallel.waitForAny, table.unpack(tasks))
  if ok or err == "Terminated" then break end
  lastErr = "crashed, restarting: " .. tostring(err)
  pcall(save)
  print(lastErr)
  sleep(5)
end

-- stopped: take the radar picture off the monitor
if gpu then pcall(gpu.clearAllDisplays) end
