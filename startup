-- [SEND] button: post a report right now and say whether it worked.
-- Waits for Discord's answer so errors show on the monitor.
local function sendReportNow()
  local function say(msg)
    toast, toastUntil = msg, nowMs() + 8000
    print("[SEND] " .. msg)        -- full text on the computer's own screen too
  end
  if not http then return say("HTTP IS DISABLED IN THE CC:TWEAKED CONFIG") end
  if not discord then return say("discord.lua NOT FOUND NEXT TO godseye.lua") end
  if not bot and CFG.webhookUrl == "" then return say("NO discord.token FILE (AND NO WEBHOOK)") end
  if bot and CFG.botChannel == "" then return say("SET botChannel IN godseye.cfg") end

  say("SENDING...")
  local now = nowSec()
  local since = math.min(state.lastReportT or (now - 3600), now - 3600)
  local quiet = CFG.quietReports
  CFG.quietReports = false
  local payload, names = buildReport(since, now)
  CFG.quietReports = quiet
  payload.embeds[1].title = "GOD'S EYE // Manual report for " .. CFG.baseName

  if botOn() then
    payload.username = nil
    payload.components = reportMenus(names or {})
    local res, err = bot:requestSync("POST", "/channels/" .. CFG.botChannel .. "/messages", payload)
    if res then say("REPORT SENT BY BOT - CHECK DISCORD")
    else say("BOT SEND FAILED: " .. tostring(err)) end
  else
    local h, err, eh = http.post(CFG.webhookUrl, textutils.serializeJSON(payload),
                                 { ["Content-Type"] = "application/json" })
    if h then h.close() say("REPORT SENT BY WEBHOOK - CHECK DISCORD")
    else
      local detail = eh and eh.readAll() or ""
      if eh then eh.close() end
      say("WEBHOOK FAILED: " .. tostring(err) .. " " .. detail)
    end
  end
end

