local RED_HEX = 14881563   -- 0xE3131B

-- true when anything Discord is configured (bot or webhook)
local function webhookOn() return http and (botOn() or CFG.webhookUrl ~= "") end

-- sends through the bot (with buttons) when set up, otherwise the webhook
local function postWebhook(payload, components)
  if botOn() then
    payload.username = nil                 -- bots can't rename per message
    payload.components = components
    return bot:send(CFG.botChannel, payload)
  end
  if not (http and CFG.webhookUrl ~= "") then return false end
  local ok, err = pcall(http.request, {
    url = CFG.webhookUrl,
    body = textutils.serializeJSON(payload),
    headers = { ["Content-Type"] = "application/json" },
    method = "POST",
  })
  if not ok then lastErr = "webhook: " .. tostring(err) end
  return ok
end

-- Discord components (only shown when the bot is used)
local function playerButtons(name)
  if not discord then return nil end
  return { discord.row(
    discord.button("Whitelist", "ge:white:"  .. name, discord.GREEN),
    discord.button("Blacklist", "ge:black:"  .. name, discord.RED),
    discord.button("Ignore",    "ge:ignore:" .. name, discord.GREY)) }
end

local function reportMenus(names)
  if not discord or #names == 0 then return nil end
  return {
    discord.select("ge:white",  "Whitelist...", names),
    discord.select("ge:black",  "Blacklist...", names),
    discord.select("ge:ignore", "Ignore...",    names),
  }
end

local function onSiteNames()
  local t = {}
  for _, a in pairs(active) do t[#t + 1] = a.name end
  return t
end

local function buildReport(sinceT, nowT)
  local lines, unique, nUnique, count, names = {}, {}, 0, 0, {}
  for i = #log, 1, -1 do                         -- oldest first
    local e = log[i]
    if e.arriveT and e.arriveT >= sinceT then
      count = count + 1
      if not unique[e.name] then
        unique[e.name] = true
        nUnique = nUnique + 1
        if not e.name:find("^UNKNOWN") then names[#names + 1] = e.name end
      end
      local left = e.leaveT and ("<t:%d:t>"):format(e.leaveT) or "**still here**"
      local l = listOf(e.name)
      lines[#lines + 1] = ("%s`%s` arrived <t:%d:t> | left %s | %s | closest %s"):format(
        l == "black" and "**[BLACKLISTED]** " or (l == "white" and "(whitelist) " or ""),
        e.name, e.arriveT, left,
        e.stay and fmtDur(e.stay) or "-",
        e.closest and (e.closest .. "m " .. (e.dir or "")) or "-")
    end
  end
  if count == 0 and CFG.quietReports then return nil end
  local desc = #lines > 0 and table.concat(lines, "\n") or "No contacts. All quiet."
  if #desc > 3900 then desc = desc:sub(1, 3900) .. "\n... (truncated)" end
  local here = onSiteNames()
  return {
    username = "God's Eye",
    embeds = { {
      title = "GOD'S EYE // Report for " .. CFG.baseName,
      description = desc,
      color = RED_HEX,
      fields = {
        { name = "Visits",      value = tostring(count),   inline = true },
        { name = "Unique",      value = tostring(nUnique), inline = true },
        { name = "On site now", value = #here > 0 and table.concat(here, ", ") or "nobody", inline = true },
      },
      footer = { text = ("%s - %s %s"):format(CFG.baseName, fmtT(nowT, { date = true }), CFG.tzLabel) },
      timestamp = isoUTC(nowT),
    } },
  }, names
end

local function sendArrivalAlert(entry, visits)
  local l = listOf(entry.name)
  if not webhookOn() or l == "white" then return end
  local L = lvl()
  if (not CFG.instantAlerts or not L.alerts) and l ~= "black" then return end   -- blacklist always alerts
  local k = known[entry.name]
  local cooldown = l == "black" and 60 or (L.cooldown or CFG.alertCooldown)
  if k and k.lastAlert and nowSec() - k.lastAlert < cooldown then return end
  if k then k.lastAlert = nowSec() end
  local ping = l == "black" and CFG.blackPing or (L.ping or CFG.alertPing)
  local title = l == "black" and "BLACKLISTED PLAYER: "
                or (L.hostileUnknown and "HOSTILE CONTACT: "
                or (visits <= 1 and "NEW CONTACT: " or "CONTACT: "))
  postWebhook({
    username = "God's Eye",
    content = ping ~= "" and ping or nil,
    embeds = { {
      title = title .. entry.name,
      description = ("Arrived at **%s** <t:%d:t> (%s %s)\n%s\nVisit #%d"):format(
        CFG.baseName, entry.arriveT, fmtT(entry.arriveT), CFG.tzLabel,
        entry.closest and ("First seen %dm %s of base"):format(entry.closest, entry.dir or "")
          or ((entry.dir or "") ~= "" and ("Seen %s of base"):format(entry.dir) or ""),
        visits) .. ("\nBase level: **%d %s**"):format(curLevel(), L.name)
        .. (entry.source and ("\nReported by **" .. entry.source .. "** (remote)") or ""),
      color = RED_HEX,
      timestamp = isoUTC(entry.arriveT),
    } },
  }, (not entry.name:find("^UNKNOWN")) and playerButtons(entry.name) or nil)
end

local function reportKey(utc)
  return math.floor(localSec(utc) / (CFG.reportMinutes * 60))
end

local function checkReport()
  if not webhookOn() then return end
  local now = nowSec()
  local key = reportKey(now)
  if not state.lastReportKey then                -- first boot: start the clock
    state.lastReportKey, state.lastReportT = key, now
    save()
    return
  end
  if key ~= state.lastReportKey then
    local payload, names = buildReport(state.lastReportT or (now - CFG.reportMinutes * 60), now)
    if payload then postWebhook(payload, reportMenus(names or {})) end
    state.lastReportKey, state.lastReportT = key, now
    save()
  end
end

