-- Your own settings live in godseye.cfg so updating this file never wipes them.
-- Anything in godseye.cfg overrides the defaults above.
do
  -- reads <program name>.cfg (e.g. godseyeDGPU.cfg), falling back to godseye.cfg
  local prog = shell and shell.getRunningProgram() or "godseye.lua"
  local dir = fs.getDir(prog)
  local base = fs.getName(prog):gsub("%.lua$", "")
  local path = fs.combine(dir, base .. ".cfg")
  if not fs.exists(path) then path = fs.combine(dir, "godseye.cfg") end
  if not fs.exists(path) then path = fs.combine(dir, "godseyeDGPU.cfg") end
  if fs.exists(path) then
    local fn, err = loadfile(path, nil, {})
    local ok, user = false, nil
    if fn then ok, user = pcall(fn) end
    if ok and type(user) == "table" then
      for k, v in pairs(user) do CFG[k] = v end
    else
      printError("godseye.cfg has an error: " .. tostring(err or user))
      sleep(3)
    end
  end
end

