------------------------------------------------------------------
-- TIME  (UTC -> Mountain Time with US daylight saving)
------------------------------------------------------------------
local function nowMs()  return os.epoch("utc") end
local function nowSec() return math.floor(os.epoch("utc") / 1000) end

local function daysFromCivil(y, m, d)
  if m <= 2 then y = y - 1 end
  local era = math.floor(y / 400)
  local yoe = y - era * 400
  local doy = math.floor((153 * ((m + 9) % 12) + 2) / 5) + d - 1
  local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
  return era * 146097 + doe - 719468
end

local function nthSunday(y, m, n)          -- day number (since 1970) of nth Sunday
  local d1 = daysFromCivil(y, m, 1)
  local wd = (d1 + 4) % 7                  -- 0 = Sunday
  return d1 + (7 - wd) % 7 + (n - 1) * 7
end

local function civil(sec)                  -- UTC seconds -> y,m,d,h,mi,s (no os.date needed)
  local days = math.floor(sec / 86400)
  local rem  = sec - days * 86400
  local z = days + 719468
  local era = math.floor(z / 146097)
  local doe = z - era * 146097
  local yoe = math.floor((doe - math.floor(doe / 1460) + math.floor(doe / 36524) - math.floor(doe / 146096)) / 365)
  local y = yoe + era * 400
  local doy = doe - (365 * yoe + math.floor(yoe / 4) - math.floor(yoe / 100))
  local mp = math.floor((5 * doy + 2) / 153)
  local d = doy - math.floor((153 * mp + 2) / 5) + 1
  local m = mp < 10 and mp + 3 or mp - 9
  if m <= 2 then y = y + 1 end
  return y, m, d, math.floor(rem / 3600), math.floor(rem % 3600 / 60), rem % 60
end

local function offsetHours(utc)
  local off = CFG.utcOffset
  if CFG.useDST then
    local y = civil(utc)
    local start = nthSunday(y, 3, 2) * 86400 + (2 - CFG.utcOffset) * 3600        -- 2am std
    local stop  = nthSunday(y, 11, 1) * 86400 + (2 - (CFG.utcOffset + 1)) * 3600 -- 2am DST
    if utc >= start and utc < stop then off = off + 1 end
  end
  return off
end

local function localSec(utc) utc = utc or nowSec() return utc + offsetHours(utc) * 3600 end

-- fmtT(utc, {date=true, secs=true})
local function fmtT(utc, o)
  o = o or {}
  local _, mo, d, h, mi, s = civil(localSec(utc))
  local out
  if CFG.clock12 then
    local ap = h >= 12 and "PM" or "AM"
    local h12 = h % 12 if h12 == 0 then h12 = 12 end
    out = o.secs and ("%d:%02d:%02d %s"):format(h12, mi, s, ap) or ("%d:%02d %s"):format(h12, mi, ap)
  else
    out = o.secs and ("%02d:%02d:%02d"):format(h, mi, s) or ("%02d:%02d"):format(h, mi)
  end
  if o.date then out = ("%d/%d "):format(mo, d) .. out end
  return out
end

local function isoUTC(utc)
  local y, mo, d, h, mi, s = civil(utc)
  return ("%04d-%02d-%02dT%02d:%02d:%02dZ"):format(y, mo, d, h, mi, s)
end

local function gameStamp()
  return ("D%d %s"):format(os.day(), textutils.formatTime(os.time(), true))
end

local function fmtDur(s)
  s = math.floor(s or 0)
  if s < 60 then return s .. "s" end
  if s < 3600 then return ("%dm%02ds"):format(math.floor(s / 60), s % 60) end
  return ("%dh%02dm"):format(math.floor(s / 3600), math.floor(s % 3600 / 60))
end

local atan2 = math.atan2 or math.atan
local DIRS = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }
local function compass(x, z)
  if not x then return "" end
  local dx, dz = x - CFG.baseX, z - CFG.baseZ
  if dx * dx + dz * dz < 4 then return "" end
  local a = math.deg(atan2(dx, -dz)) % 360
  return DIRS[math.floor((a + 22.5) / 45) % 8 + 1]
end

