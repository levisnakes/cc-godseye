------------------------------------------------------------------
local hudModem

local function findHudModem()
  if not CFG.hudChannel then return nil end
  if CFG.hudModem then return peripheral.wrap(CFG.hudModem) end
  return peripheral.find("modem", function(_, m) return m.isWireless and m.isWireless() end)
end
hudModem = findHudModem()

-- SECURE < CONTACT < BREACH < BLACKLIST.  LINK_LOST overrides when the detector is down.
local function threatLevel()
  if not detectorOk then return "LINK_LOST", nil end
  local level, who = "SECURE", nil
  local rank = { SECURE = 0, CONTACT = 1, BREACH = 2, BLACKLIST = 3 }
  for _, a in pairs(active) do
    if not a.friend then
      local l = a.black and "BLACKLIST"
                or ((a.dist and a.dist <= CFG.breachRadius) and "BREACH" or "CONTACT")
      if rank[l] > rank[level] then level, who = l, a.name end
    end
  end
  return level, who
end

local function broadcastHud()
  if not (hudModem and CFG.hudChannel) then return end
  local now = nowMs()
  local contacts = {}
  for _, a in pairs(active) do
    local k = known[a.name]
    contacts[#contacts + 1] = {
      name = a.name, x = a.x, y = a.y, z = a.z,
      dist = a.dist and math.floor(a.dist), dir = compass(a.x, a.z),
      list = a.black and "black" or (a.friend and "white" or "unknown"),
      visits = k and k.visits or 1,
      onSite = math.floor((now - a.first) / 1000),
      closing = a.trend and a.trend < -0.3 or false,
    }
  end
  table.sort(contacts, function(p, q) return (p.dist or 1e9) < (q.dist or 1e9) end)
  local recent = {}
  for i = 1, math.min(5, #log) do
    local e = log[i]
    recent[i] = { name = e.name, arrive = e.arriveT and fmtT(e.arriveT) or "?",
                  left = e.leaveT and fmtT(e.leaveT) or nil, dir = e.dir, closest = e.closest,
                  list = listOf(e.name) or "unknown" }
  end
  local level, who = threatLevel()
  pcall(hudModem.transmit, CFG.hudChannel, CFG.hudChannel, {
    proto = "godseye", v = 1, t = nowSec(), clock = fmtT(nowSec()),
    base = { name = CFG.baseName, x = CFG.baseX, y = CFG.baseY, z = CFG.baseZ,
             radius = CFG.radius, breach = CFG.breachRadius },
    status = level, statusWho = who,
    level = curLevel(), levelName = lvl().name, hostileUnknown = lvl().hostileUnknown or false,
    link = { radar = radar ~= nil, detector = detectorOk },
    contacts = contacts, recent = recent,
  })
end

