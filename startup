local function lower(s) return type(s) == "string" and s:lower() or "" end

local function findRadar()
  if CFG.radarName then return peripheral.wrap(CFG.radarName), CFG.radarName end
  for _, n in ipairs(peripheral.getNames()) do
    local t = lower(peripheral.getType(n))
    if t:find("radar") or t:find("filterer") or t:find("trunk") then
      return peripheral.wrap(n), n
    end
  end
end

local function findDetector()
  if CFG.detectorName then return peripheral.wrap(CFG.detectorName), CFG.detectorName end
  for _, n in ipairs(peripheral.getNames()) do
    local types = { peripheral.getType(n) }
    types[#types + 1] = n
    for _, t in ipairs(types) do
      if lower(t):gsub("[_%s:]", ""):find("playerdetector") then
        return peripheral.wrap(n), n
      end
    end
  end
end

-- a real monitor reports its size; skip the GPU block (it can show up as a "monitor" too)
local function realMonitor(name, m)
  if name:lower():find("gpu") or not m.getSize then return false end
  local ok, w, h = pcall(m.getSize)
  return ok and type(w) == "number" and type(h) == "number"
end
local mon = CFG.monitorName and peripheral.wrap(CFG.monitorName)
            or peripheral.find("monitor", realMonitor) or term.current()
local radar, radarName = findRadar()
local detector, detectorName = findDetector()
