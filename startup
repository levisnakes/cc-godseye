local log, active, known = {}, {}, {}
local lists = {}          -- lists[name] = "white" | "black"   (set from the monitor)
local state = { lastReportT = nil, lastReportKey = nil }
local lastErr = nil
local webStatus = "off"      -- live website link: "off" / "online" / "error: ..."

-- Base alert levels (like DEFCON): 5 = calm, 1 = all-out war
local LEVELS = {
  [1] = { name = "WAR",      alerts = true,  ping = "@here", cooldown = 30,  hostileUnknown = true },
  [2] = { name = "HIGH",     alerts = true,  ping = "@here", cooldown = 60,  hostileUnknown = true },
  [3] = { name = "ELEVATED", alerts = true,  ping = nil,     cooldown = 120 },
  [4] = { name = "GUARDED",  alerts = true,  ping = nil,     cooldown = nil },
  [5] = { name = "PEACE",    alerts = false, ping = nil,     cooldown = nil, quiet = true },
}
local function curLevel() return tonumber(state.level) or CFG.startLevel or 4 end
local function lvl() return LEVELS[curLevel()] or LEVELS[4] end

-- "white", "black" or nil.  Monitor choices override the config tables.
-- Minecraft names are case-insensitive, so "That_guy_luxe" matches "That_Guy_Luxe"
local function inSet(set, name)
  if set[name] then return true end
  local l = name:lower()
  for k, v in pairs(set) do
    if v and type(k) == "string" and k:lower() == l then return true end
  end
  return false
end

local function listOf(name)
  local v = lists[name]
  if v == nil then                       -- monitor/Discord choice, any capitalisation
    local l = name:lower()
    for k, val in pairs(lists) do if k:lower() == l then v = val break end end
  end
  if v == "white" or v == "black" or v == "ignore" then return v end
  if v == "normal" then return nil end
  if inSet(CFG.ignore, name) then return "ignore" end
  if inSet(CFG.blacklist, name) then return "black" end
  if inSet(CFG.friends, name) then return "white" end
  return nil
end

local function save()
  local f = fs.open(CFG.logFile, "w")
  f.write(textutils.serialize({ v = 2, log = log, known = known, state = state, lists = lists },
                              { compact = true }))
  f.close()
end

local function load()
  for _, file in ipairs({ CFG.logFile, "godseye.log" }) do   -- also reads v1 logs
    if fs.exists(file) then
      local f = fs.open(file, "r")
      local data = textutils.unserialize(f.readAll())
      f.close()
      if type(data) == "table" then
        if data.v == 2 then
          log, known, state = data.log or {}, data.known or {}, data.state or state
          lists = data.lists or {}
        else
          log = data
        end
        for _, e in ipairs(log) do if not e.leave and not e.leaveT then e.leave = "??" end end
        return
      end
    end
  end
end

