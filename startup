  if CFG.gpuName then return peripheral.wrap(CFG.gpuName), CFG.gpuName end
  for _, n in ipairs(peripheral.getNames()) do
    local t = lower(peripheral.getType(n))
    if t:find("gpu") or n:lower():find("gpu") then return peripheral.wrap(n), n end
