------------------------------------------------------------------
-- LIVE WEBSITE  (Firebase Realtime Database relay)
--   writes  <key>/live  (who's here, ships, level, status)  when it changes
--           <key>/log   (recent arrivals)                    when it changes
--           <key>/ack   (result of the last website command)
--   reads   <key>/commands  (stamps, level changes, send) and deletes them
------------------------------------------------------------------
local function webOn()
  return http ~= nil and CFG.firebaseUrl ~= "" and #CFG.firebaseKey >= 20
end

local function fbUrl(path)
  return CFG.firebaseUrl:gsub("/+$", "") .. "/" .. CFG.firebaseKey .. "/" .. path .. ".json"
end

-- method: "GET", "PUT", "DELETE". Sent as POST + override header (works everywhere).
local function fb(method, path, body)
  local req = { url = fbUrl(path), headers = { ["Content-Type"] = "application/json" } }
  local h, err, eh
  if method == "GET" then
    h, err, eh = http.get(req)
  else
    req.body = body or "null"
    req.headers["X-HTTP-Method-Override"] = method
    h, err, eh = http.post(req)
  end
  if not h then
    local detail = eh and eh.readAll() or ""
    if eh then eh.close() end
    webStatus = "error: " .. tostring(err) .. " " .. detail:sub(1, 60)
    lastErr = "web: " .. tostring(err)
    return nil
  end
  local text = h.readAll()
  h.close()
  webStatus = "online"
  if lastErr and lastErr:find("^web") then lastErr = nil end
  return text
end

local function buildLive()
  local contacts = {}
  for _, a in pairs(active) do
    contacts[#contacts + 1] = {
      name = a.name, x = a.x and math.floor(a.x), y = a.y and math.floor(a.y), z = a.z and math.floor(a.z),
      dist = a.dist and math.floor(a.dist), dir = compass(a.x, a.z),
      list = a.black and "black" or (a.friend and "white" or "unknown"),
      closing = (a.trend and a.trend < -0.3) and true or false,
      arriveT = a.entry and a.entry.arriveT,
    }
  end
  table.sort(contacts, function(p, q) return (p.dist or 1e9) < (q.dist or 1e9) end)
  local range = CFG.radarRange or CFG.radius * 1.5
  local ships = {}
  for _, sh in ipairs(shipTracks) do
    local dx, dz = sh.x - CFG.baseX, sh.z - CFG.baseZ
    if #ships < 24 and dx * dx + dz * dz <= (range * 1.2) ^ 2 then
      ships[#ships + 1] = { x = math.floor(sh.x), z = math.floor(sh.z) }
    end
  end
  local st, who = threatLevel()
  return {
    base = { name = CFG.baseName, x = CFG.baseX, y = CFG.baseY, z = CFG.baseZ,
             radius = CFG.radius, breach = CFG.breachRadius },
    range = range, tz = CFG.tzLabel,
    level = curLevel(), levelName = lvl().name,
    status = st, statusWho = who or "",
    link = { radar = radar ~= nil, detector = detectorOk },
    contacts = contacts, ships = ships,
  }
end

local function buildLog()
  local out = {}
  for i = 1, math.min(#log, CFG.webLogSize) do
    local e = log[i]
    out[#out + 1] = {
      who = e.name, list = listOf(e.name) or "unknown",
      arr = e.arriveT and fmtT(e.arriveT) or (e.arrive or "?"),
      arriveT = e.arriveT,
      left = e.leaveT and fmtT(e.leaveT) or (e.leave or false),
      stay = e.stay or false,
      close = e.closest and (e.closest .. " m " .. (e.dir or "")) or "-",
    }
  end
  return out
end

local function ack(text)
  fb("PUT", "ack", textutils.serializeJSON({ text = text, t = nowSec() }))
end

local function runCommand(c)
  if type(c) ~= "table" then return end
  if c.type == "list" and type(c.name) == "string" and c.name ~= "" then
    local which = ({ white = "white", black = "black", ignore = "ignore", unknown = "normal", normal = "normal" })[c.val]
    if which then
      setList(c.name, which, nil, "on the website")
      ack(("%s %s"):format(c.name:upper(), ({ white = "WHITELISTED", black = "BLACKLISTED",
        ignore = "IGNORED", normal = "RESET" })[which]))
    end
  elseif c.type == "level" and tonumber(c.n) then
    setLevel(tonumber(c.n), nil, "on the website")
    ack(("BASE LEVEL %d %s"):format(curLevel(), lvl().name))
  elseif c.type == "send" then
    sendReportNow()
    ack(toast or "REPORT SENT")
  end
end

local function webLoop()
  if not webOn() then
    while true do sleep(3600) end
  end
  local lastLive, lastLiveT, lastLog = "", 0, ""
  while true do
    local ok, err = pcall(function()
      local live = textutils.serializeJSON(buildLive())
      if live ~= lastLive or nowSec() - lastLiveT >= 30 then
        -- "t" goes in separately so an unchanged base doesn't count as a change
        local body = live:sub(1, -2) .. ',"t":' .. nowSec() .. "}"
        if fb("PUT", "live", body) then lastLive, lastLiveT = live, nowSec() end
      end
      local lg = textutils.serializeJSON(buildLog())
      if lg ~= lastLog then
        if fb("PUT", "log", lg) then lastLog = lg end
      end
      local cmds = fb("GET", "commands")
      if cmds and cmds ~= "null" then
        local t = textutils.unserializeJSON(cmds)
        if type(t) == "table" then
          for id, c in pairs(t) do
            fb("DELETE", "commands/" .. id)          -- delete first so it can't run twice
            runCommand(c)
          end
        end
      end
    end)
    if not ok then webStatus = "error: " .. tostring(err) end
    sleep(CFG.webEvery)
  end
end

