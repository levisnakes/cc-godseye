local RED, DARK, DIM, BRIGHT, BLACK = colors.red, colors.brown, colors.lightGray, colors.white, colors.black

if mon.setTextScale then mon.setTextScale(CFG.textScale) end
if mon.setPaletteColor then
  mon.setPaletteColor(BLACK,  0x000000)
  mon.setPaletteColor(RED,    0xE3131B)
  mon.setPaletteColor(DARK,   0x3D0406)
  mon.setPaletteColor(DIM,    0x8C2A2E)
  mon.setPaletteColor(BRIGHT, 0xFFD6D6)
end

local W, H = mon.getSize()
W, H = W or 51, H or 19
local buttons = {}
local rowTargets = {}                 -- rowTargets[y] = player name on that row
local selected, selectedUntil = nil, 0
local toast, toastUntil = nil, 0      -- short confirmation message in the footer
local sweep, logPage, pageCount = 0, 1, 1
local confirmClearUntil = 0
local levelPickUntil = 0
local page = "log"                    -- "log" (text monitor) or "radar" (GPU)
local disp, dpw, dph = nil, 0, 0      -- DirectGPU display id + pixel size (radar page)

local function mark(name)             -- prefix shown before names
  local l = listOf(name)
  return l == "black" and "!" or (l == "white" and "+" or "")
end

local function fit(s, n)
  s = tostring(s or "")
  if n <= 0 then return "" end
  if #s > n then return s:sub(1, n) end
  return s .. (" "):rep(n - #s)
end

local function put(x, y, s, fg, bg)
  mon.setCursorPos(x, y)
  mon.setBackgroundColor(bg or BLACK)
  mon.setTextColor(fg or RED)
  mon.write(s)
end

local function bar(y, bg) put(1, y, (" "):rep(W), RED, bg) end
local function section(x, y, w, title) put(x, y, fit(" " .. title, w), RED, DARK) end

local function drawHeader()
  local flashing = nowMs() < alertUntil and (math.floor(nowMs() / 400) % 2 == 0)
  local bg = flashing and BRIGHT or RED
  bar(1, bg)
  put(2, 1, "<(\7)>  G O D ' S   E Y E", BLACK, bg)
  local c = fmtT(nowSec(), { secs = true }) .. " " .. CFG.tzLabel
  put(W - #c, 1, c, BLACK, bg)

  bar(2, BLACK)
  local n, intr, blk = 0, 0, nil
  for _, a in pairs(active) do
    n = n + 1
    if not a.friend then intr = intr + 1 end
    if a.black then blk = a.name end
  end
  local disc
  if botOn() then disc = "BOT:" .. (bot.status == "online" and "ON" or bot.status:upper())
  else disc = "HOOK:" .. (webhookOn() and "ON" or "OFF") end
  local status = ("LVL %d %s  RADAR:%s  DETECT:%s  WEB:%s  %s  %s"):format(
    curLevel(), lvl().name, radar and "ON" or "--", detectorOk and "ON" or (detector and "ERR" or "OFF"),
    webStatus == "online" and "ON" or (webStatus == "off" and "--" or "ERR"), disc, CFG.baseName)
  put(2, 2, fit(status, W - 15), DIM)
  local tag = (not detectorOk) and "!! LINK LOST !!" or blk and ("!! BLACKLISTED: " .. blk .. " !!")
              or (intr > 0 and ("! %d INTRUDER%s !"):format(intr, intr > 1 and "S" or "")
              or (n > 0 and "WHITELIST ONLY" or "AREA CLEAR"))
  if blk or not detectorOk then put(W - #tag, 2, tag, BLACK, RED)
  else put(W - #tag, 2, tag, intr > 0 and BRIGHT or DIM) end
  bar(3, DARK)
end

local function logRow(e)
  local arrive = e.arriveT and fmtT(e.arriveT, { date = true }) or (e.arrive or "?")
  local left
  if e.leaveT then left = fmtT(e.leaveT)
  elseif e.leave then left = e.leave
  else left = "ON SITE" end
  local who = mark(e.name) .. (e.source and "*" or "") .. e.name   -- * = reported by a pocket
  local close = e.closest and (e.closest .. "m " .. (e.dir or "")) or ((e.dir or "") ~= "" and e.dir) or "-"
  return ("%s %s %s %s %s"):format(fit(arrive, 14), fit(who, 16), fit(left, 8),
    fit(e.stay and fmtDur(e.stay) or "", 6), close)
end

local listRight = 0
local function drawLists(x, w, top, bottom)
  listRight = x + w - 1
  local list = {}
  for _, a in pairs(active) do list[#list + 1] = a end
  table.sort(list, function(p, q) return (p.dist or 1e9) < (q.dist or 1e9) end)

  local y = top
  section(x, y, w, ("ON SITE NOW (%d)"):format(#list)) y = y + 1
  local maxActive = math.max(2, math.min(#list, math.floor((bottom - top) / 3)))
  if #list == 0 then
    put(x, y, fit("  no contacts", w), DIM) y = y + 1
  else
    for i = 1, math.min(#list, maxActive) do
      local a = list[i]
      local k = known[a.name]
      local d = a.dist and (math.floor(a.dist) .. "m " .. compass(a.x, a.z)) or "?m"
      local tag = a.black and "BLACKLIST" or (a.friend and "WHITELIST"
                  or ((k and k.visits <= 1) and "NEW" or ("x" .. (k and k.visits or 1))))
      local row = ("%s %s %-8s %-7s %s"):format(a.friend and " " or "\16",
                  fit(mark(a.name) .. a.name, 16), d, fmtDur((nowMs() - a.first) / 1000), tag)
      local fg, bg = a.friend and DIM or BRIGHT, BLACK
      if a.black then fg, bg = BLACK, RED end
      if a.name == selected then bg = DARK fg = BRIGHT end
      put(x, y, fit(row, w), fg, bg)
      rowTargets[y] = a.name
      y = y + 1
    end
  end
  put(x, y, (" "):rep(w)) y = y + 1          -- clear spacer (stops leftover rows)

  section(x, y, w, "ARRIVAL LOG") y = y + 1
  put(x, y, fit(("%-14s %-16s %-8s %-6s %s"):format("ARRIVED", "WHO", "LEFT", "STAYED", "CLOSEST"), w), DIM)
  y = y + 1
  local rows = math.max(1, bottom - y + 1)
  pageCount = math.max(1, math.ceil(#log / rows))
  if logPage > pageCount then logPage = pageCount end
  local first = (logPage - 1) * rows + 1
  for i = first, math.min(#log, first + rows - 1) do
    local e = log[i]
    local l = listOf(e.name)
    local fg = (not e.leaveT and not e.leave) and BRIGHT or (l == "white" and DIM or RED)
    if l == "black" then fg = BRIGHT end
    local bg = (e.name == selected) and DARK or BLACK
    put(x, y, fit(logRow(e), w), fg, bg)
    rowTargets[y] = e.name
    y = y + 1
  end
  while y <= bottom do put(x, y, (" "):rep(w)) y = y + 1 end
end

local function drawScope(x0, y0, pw, ph)
  local cx, cy = (pw + 1) / 2, (ph + 1) / 2
  local blips = {}
  for _, a in pairs(active) do
    if a.x then
      local bx = math.floor(cx + (a.x - CFG.baseX) / CFG.radius * (pw / 2) + 0.5)
      local by = math.floor(cy + (a.z - CFG.baseZ) / CFG.radius * (ph / 2) + 0.5)
      blips[by * 1000 + bx] = a
    end
  end
  local BK, RD, DK, DM, BR = colors.toBlit(BLACK), colors.toBlit(RED),
                             colors.toBlit(DARK), colors.toBlit(DIM), colors.toBlit(BRIGHT)
  for py = 1, ph do
    local t, f, b = {}, {}, {}
    for px = 1, pw do
      local dx, dy = (px - cx) / (pw / 2), (py - cy) / (ph / 2)
      local r = math.sqrt(dx * dx + dy * dy)
      local ch, fg, bg = " ", DM, BK
      if r <= 1.02 then
        local ang = (atan2(dy, dx) - sweep) % (2 * math.pi)
        if ang > 2 * math.pi - 0.45 then bg = DK end
        if math.abs(r - 1) < 0.06 or math.abs(r - 0.5) < 0.04 then ch = "\7" end
        if math.abs(dx) < 0.02 or math.abs(dy) < 0.03 then ch = "\183" end
      end
      if py == 1 and px == math.floor(cx + 0.5) then ch, fg = "N", RD end
      if px == math.floor(cx + 0.5) and py == math.floor(cy + 0.5) then ch, fg = "+", RD end
      local a = blips[py * 1000 + px]
      if a then ch, fg, bg = a.name:sub(1, 1):upper(), BK, a.black and RD or (a.friend and DM or BR) end
      t[px], f[px], b[px] = ch, fg, bg
    end
    mon.setCursorPos(x0, y0 + py - 1)
    mon.blit(table.concat(t), table.concat(f), table.concat(b))
  end
end

local function nextReportIn()
  if not webhookOn() then return nil end
  local period = CFG.reportMinutes * 60
  local ls = localSec(nowSec())
  return period - ls % period
end

local function drawFooter()
  bar(H, DARK)
  buttons = {}
  local x = W
  local function button(id, label, fg, bg)
    x = x - #label
    put(x, H, label, fg or BLACK, bg or RED)
    buttons[#buttons + 1] = { id = id, x1 = x, x2 = x + #label - 1, y = H }
    x = x - 1
  end

  -- selection mode: list buttons for the tapped player
  if selected and nowMs() < selectedUntil then
    local l = listOf(selected)
    button("deselect", "[X]", BLACK, RED)
    button("ignore", "[IGNORE]", BLACK, DIM)
    button("normal", "[NORMAL]", BLACK, l == nil and BRIGHT or DIM)
    button("black", "[BLACKLIST]", BLACK, l == "black" and BRIGHT or RED)
    button("white", "[WHITELIST]", BLACK, l == "white" and BRIGHT or DIM)
    local k = known[selected]
    local info = ("%s  %s  visits:%d"):format(selected,
      l == "black" and "BLACKLISTED" or (l == "white" and "WHITELISTED" or "unlisted"),
      k and k.visits or 0)
    put(2, H, fit(info, x - 2), BRIGHT, DARK)
    return
  end
  selected = nil

  -- level picker
  if nowMs() < levelPickUntil then
    button("lvlx", "[X]", BLACK, RED)
    for n = 5, 1, -1 do
      local on = n == curLevel()
      button("lvl" .. n, ("[%d %s]"):format(n, LEVELS[n].name), BLACK,
             on and BRIGHT or (n <= 2 and RED or DIM))
    end
    put(2, H, fit("SET BASE LEVEL:", x - 2), BRIGHT, DARK)
    return
  end

  local confirming = nowMs() < confirmClearUntil
  button("clear", confirming and "[ TAP AGAIN ]" or "[ CLEAR LOG ]", BLACK, confirming and BRIGHT or RED)
  button("next", "[>]")
  local pg = ("%d/%d"):format(logPage, pageCount)
  x = x - #pg put(x, H, pg, DIM, DARK) x = x - 1
  button("prev", "[<]")
  button("send", "[SEND]", BLACK, BRIGHT)
  button("radar", "[RADAR]", BLACK, BRIGHT)
  button("level", ("[LVL %d]"):format(curLevel()), BLACK, curLevel() <= 2 and BRIGHT or RED)

  local info
  if toast and nowMs() < toastUntil then info = toast
  elseif lastErr then info = "ERR " .. lastErr
  elseif botOn() and bot.status ~= "online" and bot.lastError then info = "BOT " .. bot.lastError
  else
    local nr = nextReportIn()
    info = ("LOGGED %d  SEEN %d%s"):format(#log, (function() local c = 0 for _ in pairs(known) do c = c + 1 end return c end)(),
      nr and ("  REPORT IN " .. fmtDur(nr)) or "")
  end
  put(2, H, fit(info, x - 2), lastErr and BRIGHT or DIM, DARK)
end

local function draw()
  local w, h = mon.getSize()
  if type(w) ~= "number" then return end      -- monitor busy/unplugged: skip this frame
  W, H = w, h
  rowTargets = {}
  drawHeader()
  local top, bottom = 5, H - 2
  local ph = bottom - top + 1
  local pw = math.floor(ph * 1.6)
  if W - pw - 3 >= 56 and ph >= 9 then
    local listW = W - pw - 3
    put(1, 4, (" "):rep(listW + 1))
    drawLists(2, listW, top, bottom)
    section(listW + 3, top - 1, pw, ("SCOPE  R%d"):format(CFG.radius))
    drawScope(listW + 3, top, pw, ph)
  else
    drawLists(2, W - 2, top - 1, bottom)
  end
  bar(H - 1, BLACK)
  drawFooter()
end

