    for _, line in ipairs(out) do print(line) end
    local f = fs.open("probe.txt", "w") f.write(table.concat(out, "\n")) f.close()
    print("\nSaved to probe.txt  (edit probe.txt to scroll)")
  else
    print("\nNo radar found.")
  end
  return
end

------------------------------------------------------------------
-- READING CONTACTS
------------------------------------------------------------------
local RADAR_METHODS = { "getTracks", "getTargets", "getContacts", "getEntities", "scan" }

local function readRadarRaw()
  if not radar then return {} end
  for _, m in ipairs(RADAR_METHODS) do
    if type(radar[m]) == "function" then
      local ok, res = pcall(radar[m])
      if ok and type(res) == "table" then return res end
    end
  end
  return {}
end

local function xyz(t)
  local p = t.position or t.pos or t.location or t
  if type(p) ~= "table" then return end
  local x, y, z = p.x or p[1], p.y or p[2], p.z or p[3]
  if type(x) == "number" and type(z) == "number" then return x, y or CFG.baseY, z end
end

local function fromTrack(key, t)
  if type(t) ~= "table" then return end
  -- strict: only contacts the radar explicitly marks as a player
  -- (Sable ships/sub-levels and contraptions often have no type at all)
  local kind = lower(t.category) .. " " .. lower(t.type) .. " " .. lower(t.entityType) .. " " .. lower(t.kind)
  if CFG.onlyPlayers then
    if not kind:find("player") then return end
    -- something tagged PLAYER but whose entity type is not a player (e.g. Sable objects)
    local et = lower(t.entityType)
    if et ~= "" and not et:find("player") then return end
    -- block/ship-like tracks
    if kind:find("sable") or kind:find("ship") or kind:find("contraption")
       or kind:find("sub_level") or kind:find("sublevel") then return end
  end
  local ent  = type(t.entity) == "table" and t.entity or {}
  local id   = tostring(t.id or t.uuid or t.entityId or ent.uuid or t.trackId or key)
  local name = t.name or t.playerName or t.displayName or t.username or t.entityName or ent.name
  if type(name) ~= "string" or name == "" then name = nil end
  local x, y, z = xyz(t)
  return { id = "R:" .. id, name = name or ("UNKNOWN-" .. id:sub(1, 5)),
           named = name ~= nil, x = x, y = y, z = z }
end

local detectorOk, linkLostAt = false, nil   -- false while the detector is unplugged / erroring

local function readDetector()
  local out = {}
  detectorOk = false
  if not detector then return out end
  local names, trusted
  for _, r in ipairs({ CFG.radius, 64, 32, 16 }) do
    if r <= CFG.radius then
      local ok, res = pcall(detector.getPlayersInRange, r)
      if ok and type(res) == "table" then names, trusted = res, true break end
      lastErr = "detector: " .. tostring(res)
    end
  end
  if not names and detector.getOnlinePlayers then
    local ok, res = pcall(detector.getOnlinePlayers)
    if ok and type(res) == "table" then names, trusted = res, false end
  end
  if not names then return out end
  detectorOk = trusted == true
  if trusted and lastErr and lastErr:find("^detector") then lastErr = nil end
  for _, n in ipairs(names) do
    local x, y, z
    local ok, p = pcall(detector.getPlayerPos, n)
    if ok and type(p) == "table" and type(p.x) == "number" then x, y, z = p.x, p.y, p.z end
    if trusted or x then
      out[#out + 1] = { id = "P:" .. n, name = n, named = true, x = x, y = y, z = z, trusted = trusted }
    end
  end
  return out
end

local function dist2D(c)
  if not c.x then return nil end
  local dx, dz = c.x - CFG.baseX, c.z - CFG.baseZ
  return math.sqrt(dx * dx + dz * dz)
end

-- radar track ids are entity UUIDs; learn which UUID belongs to which name
local uuidToName, scanCount = {}, 0
local shipTracks = {}
local function learnUuids(players)
  for _, d in ipairs(players) do
    for _, fn in ipairs({ "getPlayer", "getPlayerPos" }) do
      if detector and detector[fn] then
        local ok, p = pcall(detector[fn], d.name)
        if ok and type(p) == "table" and type(p.uuid) == "string" then
          uuidToName[p.uuid:lower()] = d.name
          break
        end
      end
    end
  end
end

-- players reported by a pocket computer (remote_injector.lua) over the modem
local remote = {}              -- remote[lowercase name] = { name, x, y, z, dir, source, untilMs }
local DIR_VEC = { N = { 0, -1 }, NE = { 1, -1 }, E = { 1, 0 }, SE = { 1, 1 },
                  S = { 0, 1 }, SW = { -1, 1 }, W = { -1, 0 }, NW = { -1, -1 } }

local function openRemote()
  if not CFG.remoteChannel then return end
  peripheral.find("modem", function(_, m) pcall(m.open, CFG.remoteChannel) return false end)
end
openRemote()

local function coord(v)
  v = tonumber(v)
  if v and v == v and math.abs(v) < 3e7 then return v end
end

-- returns ok, message (message goes back to the pocket)
local function handleRemote(msg)
  if type(msg) ~= "table" then return false, "bad packet" end
  if CFG.remoteKey ~= "" and msg.key ~= CFG.remoteKey then return false, "wrong key" end
  local name = msg.name
  if type(name) ~= "string" or not name:match("^[%w_]+$") or #name > 16 then
    return false, "bad player name"
  end
  if msg.action == "REMOVE_PLAYER" then
    local r = remote[name:lower()]
    if not r then return false, name .. " was not injected" end
    r.untilMs = 0
    return true, name .. " removed (visit closes in " .. CFG.leaveAfter .. "s)"
  end
  if msg.action ~= "INJECT_PLAYER" then return false, "unknown action" end
  local x, y, z = coord(msg.x), coord(msg.y), coord(msg.z)
  if (x == nil) ~= (z == nil) then return false, "need both x and z" end
  local dir = type(msg.dir) == "string" and msg.dir:upper() or nil
  if dir and not DIR_VEC[dir] then dir = nil end
  local dist = coord(msg.dist)
  if not x and dir and dist then           -- "NW 60" -> a point 60 blocks NW of base
    local v = DIR_VEC[dir]
    local len = math.sqrt(v[1] * v[1] + v[2] * v[2])
    x = math.floor(CFG.baseX + v[1] / len * dist + 0.5)
    z = math.floor(CFG.baseZ + v[2] / len * dist + 0.5)
  end
  remote[name:lower()] = {
    name = name, x = x, y = y or (x and CFG.baseY), z = z, dir = dir,
    source = type(msg.source) == "string" and msg.source:sub(1, 24) or "remote",
    untilMs = nowMs() + CFG.remoteTTL * 1000,
  }
  local where = x and ("%d %d %d"):format(math.floor(x), math.floor(y or CFG.baseY), math.floor(z))
                or (dir or "no position")
  return true, name .. " injected at " .. where
end

local function remoteContacts(named, blips)
  local out, now = {}, nowMs()
  local seen = {}                          -- don't double up on someone the hardware already sees
  for _, d in ipairs(named) do seen[d.name:lower()] = true end
  for _, c in ipairs(blips) do if c.named then seen[c.name:lower()] = true end end
  for key, r in pairs(remote) do
    if now > r.untilMs then
      remote[key] = nil
    elseif not seen[key] then
      out[#out + 1] = { id = "X:" .. r.name, name = r.name, named = true, x = r.x, y = r.y, z = r.z,
                        dir = r.dir, source = r.source, trusted = true }
    end
  end
  return out
end

local function scan()
  local named = readDetector()
  scanCount = scanCount + 1
  if scanCount % 15 == 1 then learnUuids(named) end
  local blips = {}
  local ships = {}
  for k, t in pairs(readRadarRaw()) do
    local c = fromTrack(k, t)
    if c then blips[#blips + 1] = c end
    if type(t) == "table" then                 -- ships/contraptions for the radar page
      local kind = lower(t.category) .. " " .. lower(t.type) .. " " .. lower(t.entityType) .. " " .. lower(t.kind)
      if kind:find("sable") or kind:find("ship") or kind:find("contraption")
         or kind:find("sub_level") or kind:find("sublevel") then
        local x, y, z = xyz(t)
        if x then ships[#ships + 1] = { x = x, y = y, z = z } end
      end
    end
  end
  shipTracks = ships
  local claimed = {}
  local function claim(d, c)
    claimed[d] = true
    c.dropped = true
    if not d.x then d.x, d.y, d.z = c.x, c.y, c.z end
  end
  -- 1) radar UUID -> name (learned from the detector when it shares UUIDs)
  for _, c in ipairs(blips) do
    if not c.named then
      local n = uuidToName[c.id:sub(3):lower()]
      if n then c.name, c.named = n, true end
    end
  end
  -- 2) same name, or 3) detector position close to the blip
  for _, c in ipairs(blips) do
    for _, d in ipairs(named) do
      if not claimed[d] then
        local sameName = c.named and c.name == d.name
        local samePos  = not c.named and c.x and d.x
                         and math.abs(d.x - c.x) < 12 and math.abs(d.z - c.z) < 12
        if sameName or samePos then claim(d, c) break end
      end
    end
  end
  -- 4) server hides positions: ask the detector "who is in this small box?"
  if detector and detector.getPlayersInCoords then
    for _, c in ipairs(blips) do
      if not c.dropped and not c.named and c.x then
        local x, y, z = math.floor(c.x), math.floor(c.y or CFG.baseY), math.floor(c.z)
        local ok, res = pcall(detector.getPlayersInCoords,
          { x = x - 3, y = y - 4, z = z - 3 }, { x = x + 3, y = y + 4, z = z + 3 })
        if ok and type(res) == "table" then
          local candidates = {}
          for _, n in ipairs(res) do
            for _, d in ipairs(named) do
              if not claimed[d] and d.name == n then candidates[#candidates + 1] = d end
            end
          end
          if #candidates == 1 then claim(candidates[1], c) end
        end
      end
    end
  end
  local freeB, freeD = {}, {}
  for _, c in ipairs(blips) do if not c.dropped and not c.named then freeB[#freeB + 1] = c end end
  for _, d in ipairs(named) do if not claimed[d] then freeD[#freeD + 1] = d end end
  if #freeB == 1 and #freeD == 1 then claim(freeD[1], freeB[1]) end

  local inRange = {}
  local function consider(c)
    c.dist = dist2D(c)
    local near = c.trusted or not c.dist or c.dist <= CFG.radius
    if near and listOf(c.name) ~= "ignore" then inRange[#inRange + 1] = c end
  end
  for _, d in ipairs(named) do consider(d) end
  for _, c in ipairs(blips) do if not c.dropped then consider(c) end end
  for _, c in ipairs(remoteContacts(named, blips)) do consider(c) end
  return inRange
end

------------------------------------------------------------------
-- TRACKING VISITS
------------------------------------------------------------------
local alertUntil = 0

local function update(contacts)
  local now, nowS, changed = nowMs(), nowSec(), false
  for _, c in ipairs(contacts) do
    local a = active[c.id]
    if not a then
      local l = listOf(c.name)
      local friend = l == "white" or nil
      local k = known[c.name] or { visits = 0 }
      known[c.name] = k
      k.visits = k.visits + 1
      k.last = nowS
      local entry = { name = c.name, arriveT = nowS, game = gameStamp(), friend = friend,
                      closest = c.dist and math.floor(c.dist),
                      dir = (c.x and compass(c.x, c.z)) or c.dir or "",
                      visit = k.visits, source = c.source }
      table.insert(log, 1, entry)
      while #log > CFG.maxLog do table.remove(log) end
      a = { name = c.name, first = now, entry = entry, closest = c.dist or math.huge, friend = friend }
      active[c.id] = a
      changed = true
      if not friend then
        alertUntil = now + (l == "black" and 15000 or 6000)
        if speaker then
          if l == "black" then
            for i = 1, 3 do pcall(speaker.playNote, "pling", 3, 24 - i * 4) end
            pcall(speaker.playSound, "minecraft:block.bell.use", 3, 1)
          elseif not lvl().quiet then
            pcall(speaker.playNote, "bit", lvl().hostileUnknown and 3 or 2, 18)
          end
        end
        sendArrivalAlert(entry, k.visits)
      end
    end
    local l = listOf(c.name)                  -- live, so list changes apply instantly
    a.friend, a.black = (l == "white") or nil, (l == "black") or nil
    if c.dist and a.dist then                 -- smoothed: negative = closing in
      a.trend = (a.trend or 0) * 0.6 + (c.dist - a.dist) * 0.4
    end
    a.last, a.x, a.y, a.z, a.dist = now, c.x, c.y, c.z, c.dist
    if c.dist and c.dist < a.closest then
      a.closest = c.dist
      a.entry.closest = math.floor(c.dist)
      a.entry.dir = compass(c.x, c.z)
    end
  end
  -- Link guard: if the detector dropped off the network, everyone "vanishes".
  -- Don't log that as them leaving (it causes fake leave + fake NEW CONTACT alerts
  -- when it reconnects). Hold visits open for linkGrace seconds.
  if detectorOk then
    if linkLostAt then
      for _, a in pairs(active) do a.last = math.max(a.last, now - 1000) end
    end
    linkLostAt = nil
  else
    linkLostAt = linkLostAt or now
    if not lastErr then lastErr = "detector link lost" end
  end
  local holding = linkLostAt and (now - linkLostAt) < CFG.linkGrace * 1000
  for id, a in pairs(active) do
    if not holding and now - a.last > CFG.leaveAfter * 1000 then
      a.entry.leaveT = math.floor(a.last / 1000)
      a.entry.stay   = math.floor((a.last - a.first) / 1000)
      if known[a.name] then known[a.name].last = a.entry.leaveT end
      active[id] = nil
      changed = true
    end
  end
  if changed then save() end
  if CFG.alarmSide then
    local intruder = false
    for _, a in pairs(active) do if not a.friend then intruder = true end end
    redstone.setOutput(CFG.alarmSide, intruder)
  end
end

